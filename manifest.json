{
  "manifest_version": 3,
  "name": "Canvas Planning Calendar",
  "version": "0.2.1",
  "description": "Workload charts, task estimates and balanced study plans for Illinois Canvas.",
  "permissions": ["storage"],
  "host_permissions": ["https://canvas.illinois.edu/*"],
  "action": { "default_title": "Toggle planning calendar" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://canvas.illinois.edu/calendar*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
